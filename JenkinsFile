pipeline {

    agent any
    environment {
        SONAR_TOKEN = credentials('SONAR_TOKEN')
    }
    stages {

        stage('Prepare') {
            steps {
                sh 'mkdir -p results'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                docker exec devcontainer-backend-1 \
                pip install -r requirements.txt
                '''
            }
        }

        stage('Unit Tests') {
            steps {

                sh '''
                docker exec devcontainer-backend-1 \
                mkdir -p /app/results
                '''

                sh '''
                docker exec devcontainer-backend-1 \
                pytest tests/test_product_service.py tests/test_stock_service.py \
                -v \
                --cov=. --cov-report=xml:results/coverage.xml --cov-report=term \
                --junitxml=/app/results/unit.xml
                '''

                sh 'docker cp devcontainer-backend-1:/app/results/unit.xml results/unit.xml'
                sh 'docker cp devcontainer-backend-1:/app/results/coverage.xml results/coverage.xml'
            }

            post {
                always {
                    junit 'results/unit.xml'
                }
            }
        }

        stage('API Tests') {

            steps {

                sh '''
                docker exec devcontainer-backend-1 \
                pytest tests/test_product_api.py \
                -v \
                --cov=. --cov-report=xml:results/coverage.xml --cov-report=term \
                --junitxml=/app/results/api.xml
                '''

                sh '''
                docker cp \
                devcontainer-backend-1:/app/results/api.xml \
                results/api.xml
                '''
                sh 'docker cp devcontainer-backend-1:/app/results/coverage.xml results/coverage.xml'
            }

            post {
                always {
                    junit 'results/api.xml'
                }
            }
        }

        stage('Product Integration Tests') {

            steps {

                sh '''
                docker exec devcontainer-backend-1 \
                pytest tests/test_product_integration.py \
                -v \
                --cov=. --cov-report=xml:results/coverage.xml --cov-report=term \
                --junitxml=/app/results/integration.xml
                '''

                sh '''
                docker cp \
                devcontainer-backend-1:/app/results/integration.xml \
                results/integration.xml
                '''
                sh 'docker cp devcontainer-backend-1:/app/results/coverage.xml results/coverage.xml'
            }

            post {
                always {
                    junit 'results/integration.xml'
                }
            }
        }
        stage('Stock Integration Tests') {
            steps {
                sh 'docker exec devcontainer-backend-1 mkdir -p /app/results'

                sh '''
                docker exec devcontainer-backend-1 \
                pytest tests/test_stock_integration.py \
                -v \
                --cov=. --cov-report=xml:results/coverage.xml --cov-report=term \
                --junitxml=/app/results/stock_integration.xml
                '''


                sh 'docker cp devcontainer-backend-1:/app/results/stock_integration.xml results/stock_integration.xml'
                sh 'docker cp devcontainer-backend-1:/app/results/coverage.xml results/coverage.xml'
            }
            post {
                always { junit 'results/stock_integration.xml' }
            }
        }
        stage('SonarCloud Analysis') {
            steps {
                withSonarQubeEnv('SonarCloud') {
                sh 'sonar-scanner'
                }
            }
            }
            stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                waitForQualityGate abortPipeline: true
                }
            }
        }
    }
}